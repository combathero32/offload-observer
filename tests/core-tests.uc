let checks = 0;
function ok(condition, message) { if (!condition) die('FAIL: '+message+'\n'); checks++; }
function eq(a,b,message) { ok(sprintf('%J',a)==sprintf('%J',b),message); }
let cfg = {networks:['192.168.19.0/24','2001:db8:19::/64'],router_ips:{},flow_max:4096,group_max:512};
let fixture = 'ipv4 2 tcp 6 src=192.168.19.243 dst=203.0.113.10 sport=8188 dport=8080 packets=31 bytes=4764 src=203.0.113.10 dst=192.168.16.128 sport=8080 dport=8188 packets=31 bytes=37045 [HW_OFFLOAD] mark=1024 zone=0 use=3';
let first = parse_ct(fixture);
ok(first.hw,'detect hardware status'); eq(first.sent,4764,'original counter'); eq(first.received,37045,'reply counter');
ok(parse_ct(replace(fixture,'bytes=4764','bytes=oops')) == null,'reject invalid counters');
ok(parse_ct(replace(fixture,'tcp','icmp')) == null,'exclude unsupported protocol');
eq(ip_key('2001:db8::1'),ip_key('2001:0db8:0000:0:0:0:0:1'),'canonical IPv6 matching');
ok(in_cidr('2001:db8:19::abcd','2001:db8:19::/64'),'IPv6 LAN membership');
ok(!in_cidr('2001:db8:20::1','2001:db8:19::/64'),'IPv6 outside LAN');
ok(in_cidr('192.168.19.243','192.168.19.0/24'),'IPv4 LAN membership');
ok(!in_cidr('192.168.20.1','192.168.19.0/24'),'IPv4 outside LAN');
ok(ip_bytes('192.168.19.999') == null,'reject invalid address');
ok(ip_bytes('1::2::3') == null,'reject malformed IPv6');
eq(ip_key('::ffff:192.0.2.1'),ip_key('0:0:0:0:0:ffff:c000:201'),'IPv4 embedded in IPv6');
let state = new_state();
sample(state,[first],cfg,{}, {},5,0);
eq(state.total,{up:0,down:0},'startup establishes baseline without importing past traffic');
let second = parse_ct(replace(replace(fixture,'bytes=4764','bytes=100158'),'bytes=37045','bytes=7737249'));
sample(state,[second],cfg,{}, {},10,0);
eq(state.total,{up:95394,down:7700204},'hardware conntrack deltas');
eq(state.hw,1,'active offloaded count');
eq(state.rates.down,770020.4,'download rate uses elapsed time');
sample(state,[second],cfg,{}, {},10,0);
eq(state.total,{up:95394,down:7700204},'unchanged counters never counted twice');
sample(state,[first],cfg,{}, {},10,0);
eq(state.counter_resets,1,'counter reset detected');
eq(state.total.down,7700204,'counter reset never creates a spike');
let labels = {}, names = {}, identities = {};
let event = {type:'flow',flow:{digest:'example',local_ip:'192.168.16.128',other_ip:'203.0.113.10',local_port:8188,other_port:8080,ip_protocol:6,detected_application:10,detected_application_name:'Example app'}};
for (let item in label_event(event,names,[],100,identities)) labels[item.key] = item.label;
let geo = {}; geo[ip_key('203.0.113.10')] = 'SG';
sample(state,[second],cfg,labels,geo,10,0);
eq(state.applications['Example app'].down,7700204,'WAN-side NAT label joins original client counters');
eq(state.countries.SG.down,7700204,'country aggregation uses remote IP');
eq(state.total.down,15400408,'application identity adds no extra bytes');
sample(state,[second],cfg,{},geo,10,0);
eq(state.previous[second.key].app,'Example app','identity survives label cache eviction');
let update = label_event({type:'flow',flow:{digest:'example',detected_application:11,detected_application_name:'Later app'}},names,[],101,identities);
eq(update[0].label.name,'Later app','late classification retains initial endpoint tuple');
let unmapped = {...event,flow:{...event.flow,detected_application:0,detected_application_name:null,host_server_name:'sub.example.test'}};
eq(label_event(unmapped,names,[{suffix:'example.test',name:'Host label'}],102,{})[0].label.rank,1,'explicit hostname fallback');
unmapped.flow.host_server_name = 'example.test.attacker.test';
eq(length(label_event(unmapped,names,[{suffix:'example.test',name:'Host label'}],102,{})),0,'hostname suffix boundary');
let inbound = parse_ct('ipv4 2 tcp 6 src=203.0.113.10 dst=192.168.19.243 sport=80 dport=5000 packets=1 bytes=1000 src=192.168.19.243 dst=203.0.113.10 sport=5000 dport=80 packets=1 bytes=100 [HW_OFFLOAD] zone=0');
eq(direction(inbound,cfg.networks,{}).up,100,'inbound original direction upload reversal');
eq(direction(inbound,cfg.networks,{}).down,1000,'inbound original direction download reversal');
let dnat = parse_ct('ipv4 2 tcp 6 src=203.0.113.10 dst=192.168.16.128 sport=80 dport=5000 packets=1 bytes=1000 src=192.168.19.243 dst=203.0.113.10 sport=5000 dport=80 packets=1 bytes=100 [HW_OFFLOAD] zone=0');
eq(direction(dnat,cfg.networks,{}).client,'192.168.19.243','DNAT client identified through reply tuple');
eq(direction(dnat,cfg.networks,{}).down,1000,'DNAT inbound bytes assigned to download');
let lan = parse_ct(replace(replace(fixture,'203.0.113.10','192.168.19.42'),'203.0.113.10','192.168.19.42'));
ok(direction(lan,cfg.networks,{}) == null,'LAN-to-LAN excluded');
let router = {}; router[ip_key('192.168.19.243')] = true;
ok(direction(first,cfg.networks,router) == null,'router-originated traffic excluded');
ok(parse_ct(replace(fixture,'zone=0','zone=2')).key != first.key,'conntrack zones have distinct identities');
// A newly visible connection may have a lifetime counter from before observation.
// Its first sighting must never be assigned to the latest five-second interval.
let late_state = new_state();
sample(late_state,[first],cfg,{}, {},5,0);
let huge = {...second,key:'late-existing-connection',sent:500000000,received:12000000000};
sample(late_state,[first,huge],cfg,{}, {},5,0);
eq(late_state.total,{up:0,down:0},'late first sighting cannot import 12 GB of historical traffic');
let huge_next = {...huge,sent:500001000,received:12000200000};
sample(late_state,[first,huge_next],cfg,{}, {},5,0);
eq(late_state.total,{up:1000,down:200000},'only observed increments of late connection are counted');
sample(late_state,[first],cfg,{}, {},5,0);
sample(late_state,[first,huge_next],cfg,{}, {},5,0);
eq(late_state.total,{up:1000,down:200000},'reappearing connection never recounts its lifetime bytes');
ok(late_state.rates.down == 0,'reappearing connection cannot create a multi-gigabit rate');
sample(late_state,[first,{...huge_next,received:12000300000}],cfg,{}, {},5,0);
eq(late_state.total.down,300000,'increments resume after reappearance baseline');
eq(late_state.flows_baselined,3,'startup, late and reappearance baselines diagnosed');
eq(late_state.largest_baseline.down,12000200000,'largest ignored lifetime counter exposed');
eq(late_state.largest_counted_delta.down,200000,'largest counted increment exposed');
eq(late_state.largest_counted_delta.previous_down,12000000000,'counter diagnostics retain previous value');
eq(late_state.largest_counted_delta.current_down,12000200000,'counter diagnostics retain current value');
let fresh = parse_ct(replace(replace(fixture,'sport=8188','sport=9000'),'dport=8188','dport=9000'));
sample(state,[second,fresh],cfg,{}, {},10,0);
eq(state.applications.Unknown.down,7700204,'new flow first sighting establishes a baseline');
let total_before = state.total.down;
sample(state,[second,fresh],cfg,{}, {},10,1);
eq(state.total.down,total_before,'generation change rebaselines');
let sum_up = 0, sum_down = 0;
for (let k in state.applications) { sum_up += state.applications[k].up; sum_down += state.applications[k].down; }
eq(sum_up,state.total.up,'application upload conservation'); eq(sum_down,state.total.down,'application download conservation');
let prepared = {}; prepared[first.key] = direction(first,cfg.networks,cfg.router_ips);
let prepared_state = new_state(), ordinary_state = new_state();
sample(prepared_state,[first],cfg,{}, {},5,0,prepared);
sample(ordinary_state,[first],cfg,{}, {},5,0);
prepared[second.key] = direction(second,cfg.networks,cfg.router_ips);
sample(prepared_state,[second],cfg,{}, {},5,0,prepared);
sample(ordinary_state,[second],cfg,{}, {},5,0);
eq(prepared_state,ordinary_state,'prepared scan directions preserve all accounting');
for (let i=0;i<4200;i++) ip_key(sprintf('10.%d.%d.%d',int(i/65536),int(i/256)%256,i%256));
eq(ip_key('2001:db8::1'),ip_key('2001:0db8:0000:0:0:0:0:1'),'cache rollover preserves canonical IPv6');
eq(direction(dnat,cfg.networks,{}).down,1000,'cache rollover preserves DNAT direction');
printf('PASS: %d core checks\n',checks);
