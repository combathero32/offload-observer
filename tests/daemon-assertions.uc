assert(report().total.down == 0,'first scan establishes baseline');
feed('{"type":"flow","flow":{"digest":"test","ip_protocol":6,"local_ip":"192.168.16.128","other_ip":"203.0.113.10","local_port":8188,"other_port":8080,"detected_application":1,"detected_application_name":"Test app"}}');
input[0] = replace(replace(input[0],'bytes=4764','bytes=100158'),'bytes=37045','bytes=7737249');
db_enabled = true;
scan();
let result = report();
assert(result.total.down == 7700204,'daemon uses conntrack counter delta');
assert(result.applications[0].name == 'Test app','daemon labels NAT connection');
assert(result.clients[0].label == 'Test-client','DHCP name');
assert(result.countries[0].name == 'SG','local MMDB adapter');
assert(result.health.hw_flows == 1,'HW status exposed');
assert(result.application_coverage == 100,'label coverage');
assert(published.methods.summary.call({}).total.down == 7700204,'ubus response');
scan(); assert(report().total.down == 7700204,'repeated scan is idempotent');
assert(health.scan_lines == 1 && health.scan_ms >= 0,'scan diagnostics');
assert(interval_timer.delay == 5000 && socket_timer.delay == 250,'bounded polling timers');
sock = test_socket; health.netify_connected = true;
reads = [null];
poll_netify();
assert(sock == test_socket && health.netify_empty_polls == 1,'EAGAIN keeps socket without spinning');
assert(receive_calls == 1 && socket_timer.delay == 250,'idle poll yields after one receive');
let events_before = health.netify_events;
reads = ['{"type":"flow","flow":', '{"digest":"test"}}\n'];
poll_netify();
assert(health.netify_events == events_before,'partial JSON waits for next poll');
poll_netify();
assert(health.netify_events == events_before+1 && buffer == '','fragmented event completes');
let chunk = sprintf('%16384s',' ');
buffer = ''; reads = [chunk,chunk,chunk,chunk,chunk]; receive_calls = 0;
poll_netify();
assert(receive_calls == 4 && length(reads) == 1,'busy socket reads at most 64 KiB per poll');
assert(health.netify_budget_yields == 1 && socket_timer.delay == 250,'busy socket yields to timer');
reads = ['']; poll_netify();
assert(sock == null && !health.netify_connected && socket_closes == 1,'EOF disconnects');
assert(retry_timer.delay == 5000,'reconnect backs off');
reads = [null];sock = test_socket;socket_error = 104;poll_netify();
assert(sock == null && socket_closes == 2,'fatal receive error disconnects');
scheduled_scan(); assert(interval_timer.delay == 5000,'scan rearms after completion');
assert(report().version == '0.2.4','collector version exposed');
cfg.uplink_wifi = 'phy0-sta0';
read_uplink();
assert(report().measurement.source == 'wifi_station' && !report().measurement.valid,'Wi-Fi source begins with unavailable baseline');
station_text = replace(station_text,'tx bytes: 2000000','tx bytes: 2100000');
read_uplink();
assert(report().measurement.valid && report().total.up == 100000,'Wi-Fi totals use station increments');
assert(report().raw_conntrack.total.down == 7700204,'raw connection totals retained separately');
assert(report().breakdowns_verified == false,'unverified tables marked');
station_status = 1; read_uplink();
assert(!report().measurement.valid && report().rates.up == null,'command failure does not substitute connection rates');
station_status = 0; read_uplink();
assert(!report().measurement.valid && report().total.up == 100000,'recovery establishes new baseline');
printf('PASS: daemon compiled and 28 adapter checks\n');
