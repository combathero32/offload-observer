#!/bin/sh /etc/rc.common
USE_PROCD=1
START=96
STOP=10

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/ucode /usr/sbin/offload-observer
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/config/offload_observer
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger offload_observer
}
